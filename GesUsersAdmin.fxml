<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GesUsers.ControllersGesUsers.AdminBackUsers">

    <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f5f9ff;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Titre de la page -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #041e39;" text="Gestion des Utilisateurs" />

        <!-- Onglets pour les deux tables -->
        <TabPane style="-fx-tab-min-width: 120px;" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Onglet Parents -->
                <Tab text="Parents">
                    <content>
                        <VBox spacing="15">
                            <!-- Barre d'outils -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <TextField fx:id="parentSearchField" promptText="Rechercher..." style="-fx-pref-width: 300px; -fx-padding: 5;" />
                                <Button style="-fx-background-color: #2a75bb; -fx-text-fill: white; -fx-padding: 5 15;" text="Ajouter" />
                                <Button style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 5 15;" text="Exporter" />
                            </HBox>

                            <!-- Tableau des utilisateurs -->
                            <TableView fx:id="usersTable" style="-fx-max-height: 400;">
                                <columns>
                                    <TableColumn fx:id="colUserId" prefWidth="50" style="-fx-alignment: CENTER;" text="ID" />
                                    <TableColumn fx:id="colNom" prefWidth="120" text="Nom" />
                                    <TableColumn fx:id="colPrenom" prefWidth="120" text="Prénom" />
                                    <TableColumn fx:id="colEmail" prefWidth="180" text="Email" />
                                    <TableColumn fx:id="colRole" prefWidth="80" text="Rôle" />
                                    <TableColumn fx:id="colTypeEnfant" prefWidth="100" text="Type Enfant" />
                                    <TableColumn fx:id="colTelephone" prefWidth="100" text="Téléphone" />
                                    <TableColumn fx:id="colNaissance" prefWidth="100" text="Naissance" />
                                    <TableColumn fx:id="colScoreQuiz" prefWidth="80" style="-fx-alignment: CENTER;" text="Score Quiz" />

                                </columns>
                            </TableView>

                            <!-- Pagination -->
                            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0;">
                                <Button style="-fx-font-weight: bold;" text="◄" />
                                <Label style="-fx-font-weight: bold;" text="Page 1 sur 5" />
                                <Button style="-fx-font-weight: bold;" text="►" />
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <!-- Onglet Enfants -->
                <Tab text="Enfants">
                    <content>
                        <VBox spacing="15">
                            <!-- Barre d'outils -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <TextField fx:id="childSearchField" promptText="Rechercher..." style="-fx-pref-width: 300px; -fx-padding: 5;" />
                                <Button style="-fx-background-color: #2a75bb; -fx-text-fill: white; -fx-padding: 5 15;" text="Ajouter" />
                                <Button style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 5 15;" text="Exporter" />
                            </HBox>

                            <!-- Tableau des enfants -->
                            <TableView fx:id="childrenTable" style="-fx-max-height: 400;">
                                <columns>
                                    <TableColumn fx:id="colEnfantId" prefWidth="50" style="-fx-alignment: CENTER;" text="ID" />
                                    <TableColumn fx:id="colUsername" prefWidth="120" text="Username" />
                                    <TableColumn fx:id="colCode" prefWidth="100" text="Code" />
                                    <TableColumn fx:id="colType" prefWidth="100" text="Type" />
                                    <TableColumn fx:id="colParentId" prefWidth="80" style="-fx-alignment: CENTER;" text="Parent ID" />
                                    <TableColumn fx:id="colResQuiz" prefWidth="80" style="-fx-alignment: CENTER;" text="Score Quiz" />
                                </columns>
                            </TableView>

                            <!-- Pagination -->
                            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0;">
                                <Button style="-fx-font-weight: bold;" text="◄" />
                                <Label style="-fx-font-weight: bold;" text="Page 1 sur 5" />
                                <Button style="-fx-font-weight: bold;" text="►" />
                            </HBox>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <!-- Pied de page -->
        <Label style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-padding: 20 0 0 0;" text="Système de gestion EduCare - © 2023" />
    </VBox>
</AnchorPane>
